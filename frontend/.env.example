# Base URL of the FastAPI backend. This is the ONLY setting the frontend reads.
# Do NOT add TomTom/OpenAI keys here: every VITE_* value is public inside the browser bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional, NOT secret: default auto-refresh interval of the Incident Management page, in seconds (minimum 30).
# The page only talks to your backend; the TomTom key stays in backend/.env.
# VITE_INCIDENT_POLL_SECONDS=60
