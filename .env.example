# Optional: enables Responses API function calling in the Traffic Copilot.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: enables TomTom Traffic Flow and Incident Details endpoints.
TOMTOM_API_KEY=YOUR_TOMTOM_API_KEY_HERE

# ---------------------------------------------------------------------------
# TRAFFIC PROVIDER (live traffic map layer + traffic-aware routing)
# Select one: here (default) | tomtom | none.  Keys live ONLY in backend\.env, never in frontend\.
# HERE: create a project + API key at https://platform.here.com (see docs/HERE_SETUP.md), then paste it below.
TRAFFIC_PROVIDER=tomtom
HERE_API_KEY=
# TomTom remains an optional secondary provider (set TRAFFIC_PROVIDER=tomtom to use it):
# TOMTOM_API_KEY above.
# ---------------------------------------------------------------------------

# Optional override for OSMnx road graph place query.
OSM_PLACE_QUERY=Bhubaneswar, Khordha, Odisha, India
# Pre-cache roads once: python scripts/download_osm.py

# ---------------------------------------------------------------------------
# MERGED PROJECT NOTES
# * Copy this file to  backend\.env  (setup_windows.bat / start_backend.bat do it for you).
#   The backend loads backend\.env ONLY. Real keys belong there and NOWHERE else.
# * NEVER put TOMTOM_API_KEY or OPENAI_API_KEY in frontend\.env or any VITE_* variable:
#   Vite embeds VITE_* values into the public JavaScript bundle.
# * The frontend needs just one setting, in frontend\.env (copied from frontend\.env.example):
#       VITE_API_BASE_URL=http://127.0.0.1:8000
# * Optional: allow extra browser origins for CORS (comma-separated), e.g. a LAN address:
# CORS_ALLOW_ORIGINS=http://192.168.1.20:5173

# ---------------------------------------------------------------------------
# LOCAL LLM - OLLAMA (Traffic Copilot)
# ---------------------------------------------------------------------------
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# ---------------------------------------------------------------------------
# TOMTOM LIVE INCIDENT DETECTION (Traffic Incident Details API v5)
# Uses TOMTOM_API_KEY above. Separate from, and independent of, TomTom Traffic Flow.
# Without a key the feature reports "disabled" and shows NO incidents (nothing is ever faked).
# ---------------------------------------------------------------------------
TOMTOM_INCIDENTS_ENABLED=true
# Seconds between background polls (minimum 30; TomTom has request quotas - do not go lower).
TOMTOM_INCIDENTS_POLL_INTERVAL=60
# Poll in the background while the backend runs so routing sees fresh incidents even with no browser open.
TOMTOM_INCIDENTS_BACKGROUND_POLL=true
# Search area: minLon,minLat,maxLon,maxLat (TomTom maximum area 10,000 km2). Default = Bhubaneswar.
# TOMTOM_INCIDENTS_BBOX=85.74,20.22,85.92,20.37
# Cached incidents stop affecting routing if no successful fetch for this many seconds (they stay visible as stale).
# TOMTOM_INCIDENTS_STALE_AFTER=900
# TOMTOM_INCIDENTS_TIMEOUT=8
# TOMTOM_INCIDENTS_LANGUAGE=en-GB
# Road matching: max distance (m) from the TomTom geometry to an OSM road, and minimum match confidence.
# TOMTOM_INCIDENTS_MATCH_MAX_DISTANCE_M=30
# TOMTOM_INCIDENTS_MATCH_MIN_CONFIDENCE=0.55

# ---------------------------------------------------------------------------
# LOCATION SEARCH (Smart Route Planner) - OpenStreetMap Nominatim
# No key is needed. The public server requires an identifying User-Agent and max 1 request/second (enforced + cached).
# Put a contact e-mail or project URL in the User-Agent so OSM can reach you if needed.
# ---------------------------------------------------------------------------
NOMINATIM_USER_AGENT=TrafficIQ-Bhubaneswar/1.0 (biswapanda2006.com)
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_ENABLED=true
# Largest allowed distance (m) between a searched/clicked point and the nearest drivable road node
MAX_NODE_SNAP_DISTANCE_M=1000

# ---------------------------------------------------------------------------
# INCIDENT IMPACT RULES - optional JSON file overriding the defaults in backend/routing/impact_rules.py
# (e.g. {"reroute_min_saving_s": 90, "kinds": {"accident": {"delay_base_s": 45}}})
# ---------------------------------------------------------------------------
# INCIDENT_IMPACT_RULES=C:\path\to\impact_rules.json
